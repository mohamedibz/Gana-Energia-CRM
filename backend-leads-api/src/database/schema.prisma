generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Agente {
  id           BigInt @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  rol          String @db.VarChar(50)
  telefono     String @unique @db.VarChar(30)
  passwordHash String @map("password_hash") @db.VarChar(255)

  leads  Lead[]
  pesosCreados     Pesos[] @relation("PesosCreadoPor")
  pesosModificados Pesos[] @relation("PesosModificadoPor")
}

model Lead {
  id                BigInt  @id @default(autoincrement())
  nombre            String  @db.VarChar(150)
  telefono          String @db.VarChar(30)
  estado            String  @db.VarChar(20)
  agenteId          BigInt? @map("agente_id")
  agente            Agente? @relation(fields: [agenteId], references: [id])
  clienteNuevo      Int     @map("cliente_nuevo")
  interesComercial  Int     @map("interes_comercial")
  origen            Int
  antiguedad        Int
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  puntuaciones Puntuacion[]

  @@index([estado])
  @@index([agenteId])
}

model Puntuacion {
  // Clave primaria compuesta
  leadId     BigInt  @map("lead_id")
  version    Int
  puntuacion Float

  lead       Lead    @relation(fields: [leadId], references: [id])
  pesos      Pesos   @relation(fields: [version], references: [version])

  @@id([leadId, version])
  @@index([version, puntuacion(sort: Desc), leadId])
}

model Pesos {
  version           Int     @id @default(autoincrement())
  activo            Boolean @default(false)
  clienteNuevo      Int     @map("cliente_nuevo")
  interesComercial  Int     @map("interes_comercial")
  origen            Int
  antiguedad        Int
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  creadoPorId       BigInt?  @map("creado_por_id")
  creadoPor         Agente?  @relation("PesosCreadoPor", fields: [creadoPorId], references: [id])
  modificadoPorId   BigInt?  @map("modificado_por_id")
  modificadoPor     Agente?  @relation("PesosModificadoPor", fields: [modificadoPorId], references: [id])

  puntuaciones      Puntuacion[]
}