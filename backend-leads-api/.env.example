POSTGRES_USER=leads
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=leads_db
DATABASE_URL=postgresql://leads:cambia_esta_password@localhost:5432/leads_db
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Secreto con el que se firman los tokens (mínimo 16 caracteres). Genera el tuyo, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Paginación del listado de leads: máximo permitido en ?limit= y valor por defecto
PAGINATION_MAX_LIMIT=100
PAGINATION_DEFAULT_LIMIT=20
