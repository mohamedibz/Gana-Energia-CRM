# Opcional: copia a .env para sobrescribir los valores por defecto de docker-compose.yml
POSTGRES_USER=leads
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=leads_db
# Mínimo 16 caracteres
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Origen del frontend permitido por CORS y URL de la API vista desde el navegador
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
# Cargar datos de ejemplo si la base está vacía
SEED_ON_EMPTY=true
# Paginación del listado de leads: máximo permitido en ?limit= y valor por defecto
PAGINATION_MAX_LIMIT=100
PAGINATION_DEFAULT_LIMIT=20
